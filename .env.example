# ─────────────────────────────────────────────────────────────────────────────
# Winston — Environment Variables Reference
# Copy this file to .env and fill in your values before running locally.
# On Railway: add each variable in the Railway dashboard under Variables.
# ─────────────────────────────────────────────────────────────────────────────


# ── AI ────────────────────────────────────────────────────────────────────────

# Anthropic — Claude (claude-opus-4-5) for all chat responses and briefings.
# Get your key at: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...


# ── Voice (ElevenLabs) ────────────────────────────────────────────────────────

# ElevenLabs API key for text-to-speech (TTS) and speech-to-text (STT).
# Get your key at: https://elevenlabs.io/app/settings/api-keys
# The app checks EL_API_KEY first, then falls back to ELEVENLABS_API_KEY.
ELEVENLABS_API_KEY=sk_...
# Alias — set either this or ELEVENLABS_API_KEY (or both to the same value)
EL_API_KEY=sk_...

# Default ElevenLabs voice ID for the companion.
# David's companion (Emma Peel / Bex): XB0fDUnXU5powFXDhCwa
# Find voices at: https://elevenlabs.io/voice-library
ELEVENLABS_VOICE_ID=XB0fDUnXU5powFXDhCwa
# Alias — set either this or ELEVENLABS_VOICE_ID (or both to the same value)
EL_VOICE_ID=XB0fDUnXU5powFXDhCwa


# ── Google OAuth + APIs ───────────────────────────────────────────────────────

# Google OAuth2 credentials for login and Google API access
# (Gmail, Calendar, Contacts).
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Application type: Web Application
# Required OAuth scopes:
#   openid, email, profile,
#   https://www.googleapis.com/auth/gmail.readonly,
#   https://www.googleapis.com/auth/calendar,
#   https://www.googleapis.com/auth/contacts.readonly
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...

# OAuth callback URL — must be added to "Authorised redirect URIs" in Google Cloud.
# On Replit: leave unset (auto-derived from REPLIT_DOMAINS / REPLIT_DEV_DOMAIN).
# On Railway: set to https://your-app.railway.app/api/auth/google/callback
GOOGLE_REDIRECT_URI=https://your-app.railway.app/api/auth/google/callback


# ── Database ──────────────────────────────────────────────────────────────────

# Primary: Supabase (REST via exec_sql / exec_dml_ret RPC).
# The app uses SUPABASE_URL + SUPABASE_SERVICE_KEY when both are set.
# Get these from: https://supabase.com/dashboard → your project → Settings → API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=eyJ...   # service_role key (not the anon key)

# Supabase anon key — used for client-side / public API calls if needed.
SUPABASE_ANON_KEY=eyJ...

# Direct Supabase PostgreSQL connection string (alternative to REST calls,
# or for running migrations / psql directly).
# Found in: Supabase dashboard → Settings → Database → Connection string (URI)
SUPABASE_DB_URL=postgresql://postgres:password@db.your-project-id.supabase.co:5432/postgres

# Fallback PostgreSQL connection string — used if SUPABASE_URL is not set.
# On Railway: Railway provides this automatically as DATABASE_URL.
# On Replit: Replit provides this automatically.
DATABASE_URL=postgresql://user:password@host:5432/dbname


# ── Weather ───────────────────────────────────────────────────────────────────

# Tomorrow.io — real-time weather + 5-day forecast for Dallas and Knoxville.
# Free tier: 500 calls/day. Get your key at: https://app.tomorrow.io/development/keys
TOMORROW_IO_API_KEY=your_key_here


# ── Markets ───────────────────────────────────────────────────────────────────

# Alpha Vantage — stock quotes for SPY, DIA, QQQ, USO.
# Free tier: 25 requests/day. Get your key at: https://www.alphavantage.co/support/#api-key
# Note: free tier is often rate-limited; consider a premium plan for reliable data.
ALPHA_VANTAGE_API_KEY=your_key_here


# ── Web Push Notifications (VAPID) ───────────────────────────────────────────

# VAPID keys are required for browser push notifications.
# Generate a new pair with: npx web-push generate-vapid-keys
# Keep the private key secret — never expose it to the browser.
VAPID_PUBLIC_KEY=BNn...    # ~87 chars, starts with B
VAPID_PRIVATE_KEY=your-vapid-private-key   # ~43 chars
VAPID_EMAIL=your-email@example.com   # Shown to push services for contact


# ── App URL ───────────────────────────────────────────────────────────────────

# Public-facing URL of the app — used to build absolute URLs (OAuth callbacks,
# push notification action URLs, etc.).
# On Replit: leave unset (auto-derived from REPLIT_DOMAINS).
# On Railway: set to your Railway app domain.
APP_URL=https://your-app.railway.app


# ── Security ──────────────────────────────────────────────────────────────────

# Password for the secondary Olivia companion route (/api/olivia).
# Set to any strong password string.
OLIVIA_PASSWORD=change-me


# ── Platform (Replit-specific, not needed on Railway) ────────────────────────

# These are injected automatically by the Replit runtime.
# Do NOT set them manually on Railway — use APP_URL instead.
# REPLIT_DOMAINS=your-app.replit.app,your-app--username.replit.app
# REPLIT_DEV_DOMAIN=your-app--username.replit.dev


# ── Runtime ───────────────────────────────────────────────────────────────────

# Set by Railway and Replit automatically. Only override if needed.
# NODE_ENV=production
# PORT=8080

# Pino log level: trace | debug | info | warn | error | fatal
# Default: info
# LOG_LEVEL=info
